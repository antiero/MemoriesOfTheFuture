/* Desktop testing room: the guide, the welcome card and the Tab drawer (Mug.DesktopUI). */

:root {
    --bg: rgba(16, 18, 25, 0.93);
    --bg-raised: rgba(255, 255, 255, 0.05);
    --line: rgba(255, 255, 255, 0.08);
    --text: rgb(236, 233, 228);
    --muted: rgb(150, 156, 168);
    --mug: rgb(255, 140, 102);
    --painting: rgb(110, 198, 255);
    --green: rgb(102, 224, 138);
    --amber: rgb(255, 196, 92);
}

.dt-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--text);
    font-size: 14px;
}

Label { color: var(--text); white-space: normal; margin: 0; padding: 0; }

/* ---------------------------------------------------------------- cards */

.dt-card {
    background-color: var(--bg);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    padding: 14px 16px;
    margin-bottom: 12px;
}

.dt-eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--muted);
}

.dt-title { font-size: 21px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 2px; }
.dt-sub { font-size: 13px; color: var(--muted); margin-top: 4px; }
.dt-muted { color: var(--muted); }
.dt-small { font-size: 12px; color: var(--muted); }
.dt-row { flex-direction: row; align-items: center; }
.dt-grow { flex-grow: 1; }
.dt-shrink { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.dt-left { position: absolute; left: 20px; top: 20px; width: 380px; }

/* ---------------------------------------------------------------- status cards */

.dt-status { border-left-width: 4px; }
.dt-status--mug { border-left-color: var(--mug); }
.dt-status--painting { border-left-color: var(--painting); }
.dt-status__label { font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; }
.dt-status--mug .dt-status__label { color: var(--mug); }
.dt-status--painting .dt-status__label { color: var(--painting); }
.dt-status__title { font-size: 19px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 6px; }
.dt-status__hint { font-size: 13px; color: var(--muted); margin-top: 3px; }

.dt-bar { height: 5px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.08); margin-top: 10px; overflow: hidden; }
.dt-bar__fill { height: 100%; border-radius: 3px; background-color: var(--mug); }
.dt-status--painting .dt-bar__fill { background-color: var(--painting); }

.dt-pips { flex-direction: row; margin-top: 10px; }
.dt-pip { width: 22px; height: 6px; border-radius: 3px; margin-right: 5px; background-color: rgba(255, 255, 255, 0.10); }
.dt-pip--on { background-color: var(--painting); }

.dt-chip {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--muted);
    background-color: var(--bg-raised);
    border-radius: 9px;
    padding: 2px 8px;
}

/* ---------------------------------------------------------------- keys */

.dt-guide { position: absolute; left: 20px; bottom: 20px; width: 380px; margin-bottom: 0; }
.dt-keygroup { font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; color: var(--muted); margin-top: 8px; margin-bottom: 4px; }
.dt-keyrow { flex-direction: row; align-items: center; margin-bottom: 3px; }
.dt-keys { flex-direction: row; width: 120px; flex-shrink: 0; flex-wrap: wrap; }
.dt-key {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(244, 242, 238);
    background-color: rgb(44, 48, 60);
    border-radius: 6px;
    border-bottom-width: 3px;
    border-bottom-color: rgb(20, 22, 30);
    padding: 2px 7px 1px 7px;
    min-width: 24px;
    -unity-text-align: middle-center;
    margin-right: 4px;
    margin-bottom: 2px;
}
.dt-keytext { font-size: 13px; flex-shrink: 1; flex-grow: 1; }

.dt-pill {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    padding: 6px 14px 6px 8px;
}
.dt-pill .dt-key { margin-bottom: 0; }
.dt-guide-pill { left: 20px; bottom: 20px; }
.dt-look-hint { position: relative; }
.dt-look-hint Label { font-size: 13px; }

/* centred strips (absolute children can't centre themselves) */
.dt-strip { position: absolute; left: 0; right: 0; align-items: center; }
.dt-strip--top { top: 22px; }
.dt-strip--bottom { bottom: 24px; }

.dt-crosshair {
    position: absolute;
    left: 50%; top: 50%;
    width: 6px; height: 6px;
    margin-left: -3px; margin-top: -3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.75);
}

/* ---------------------------------------------------------------- toast */

.dt-toast {
    background-color: rgba(16, 18, 25, 0.92);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--line);
    padding: 8px 18px;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    translate: 0 -8px;
}
.dt-toast--on { opacity: 1; translate: 0 0; }
.dt-toast Label { font-size: 14px; -unity-font-style: bold; }

/* ---------------------------------------------------------------- buttons */

.dt-btn {
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    border-radius: 8px;
    color: rgb(240, 238, 234);
    -unity-font-style: bold;
    font-size: 13px;
    height: 32px;
    padding: 0 14px;
    margin: 0 6px 0 0;
}
.dt-btn:hover { background-color: rgba(255, 255, 255, 0.14); }
.dt-btn:active { background-color: rgba(255, 255, 255, 0.20); }
.dt-btn--primary { background-color: var(--mug); color: rgb(28, 20, 16); }
.dt-btn--primary:hover { background-color: rgb(255, 160, 128); }
.dt-btn--small { height: 24px; font-size: 12px; padding: 0 8px; border-radius: 6px; }
.dt-btn--icon { width: 26px; height: 24px; padding: 0; font-size: 14px; border-radius: 6px; margin: 0; }

.dt-toggle {
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 0;
    border-radius: 6px;
    color: rgb(196, 200, 210);
    -unity-font-style: bold;
    font-size: 12px;
    height: 24px;
    min-width: 26px;
    padding: 0 7px;
    margin: 0 0 0 4px;
}
.dt-toggle:hover { background-color: rgba(255, 255, 255, 0.12); }
.dt-toggle--solo { background-color: var(--amber); color: rgb(30, 24, 10); }
.dt-toggle--mute { background-color: rgb(232, 86, 86); color: rgb(255, 255, 255); }
.dt-toggle--on { background-color: rgba(255, 255, 255, 0.22); color: rgb(255, 255, 255); }

/* ---------------------------------------------------------------- drawer */

.dt-drawer {
    background-color: rgba(16, 18, 25, 0.95);
    position: absolute;
    right: 20px; top: 20px; bottom: 20px;
    width: 480px;
    padding: 16px 16px 12px 16px;
    margin-bottom: 0;
}
.dt-drawer > .dt-row { flex-shrink: 0; }
.dt-tabs { flex-shrink: 0; flex-direction: row; background-color: rgba(255, 255, 255, 0.05); border-radius: 10px; padding: 3px; margin-top: 12px; margin-bottom: 12px; }
.dt-tab {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    color: var(--muted);
    -unity-font-style: bold;
    font-size: 13px;
    height: 30px;
    margin: 0;
}
.dt-tab:hover { color: rgb(255, 255, 255); }
.dt-tab--on { background-color: rgba(255, 255, 255, 0.13); color: rgb(255, 255, 255); }

.dt-scroll { flex-grow: 1; flex-shrink: 1; }
.dt-scroll .unity-scroll-view__content-container { padding-right: 10px; }

/* thin scrollbar (the default one is a grey slab) */
.dt-root .unity-scroller--vertical { width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.dt-root .unity-scroller__low-button,
.dt-root .unity-scroller__high-button { display: none; }
.dt-root .unity-scroller .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.04); border-radius: 3px; }
.dt-root .unity-scroller .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.28); border-radius: 3px; width: 6px; left: 0; }
.dt-root .unity-scroller .unity-slider { margin: 0; }
.dt-section { font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; color: var(--muted); margin-top: 14px; margin-bottom: 8px; }
.dt-note { font-size: 12px; color: var(--muted); margin-top: 8px; }
.dt-banner { background-color: rgba(255, 196, 92, 0.14); border-radius: 8px; padding: 8px 10px; margin-top: 8px; }
.dt-banner Label { color: var(--amber); font-size: 12px; -unity-font-style: bold; }

.dt-box { background-color: var(--bg-raised); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }

/* mix snapshot meters */
.dt-meter { flex-grow: 1; margin-right: 8px; }
.dt-meter Label { font-size: 11px; color: var(--muted); }
.dt-meter .dt-bar { margin-top: 4px; }
.dt-meter .dt-bar__fill { background-color: var(--green); }

/* slot cards */
.dt-slot { background-color: var(--bg-raised); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); }
.dt-slot--playing { border-left-color: var(--green); }
.dt-slot__dot { width: 8px; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.18); margin-right: 8px; }
.dt-slot--playing .dt-slot__dot { background-color: var(--green); }
.dt-slot__name { font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.dt-slot__group { font-size: 11px; color: var(--muted); margin-left: 8px; }
.dt-slot__file { font-size: 12px; color: var(--muted); flex-grow: 1; flex-shrink: 1; margin: 0 6px; -unity-text-align: middle-center; }
.dt-slot__file--override { color: var(--amber); }
.dt-field { flex-direction: row; align-items: center; margin-top: 6px; }
.dt-field__label { font-size: 12px; color: var(--muted); width: 150px; flex-shrink: 0; }
.dt-field__value { font-size: 12px; -unity-font-style: bold; width: 64px; -unity-text-align: middle-right; flex-shrink: 0; }
.dt-field Slider { flex-grow: 1; margin: 0 8px 0 0; }
.dt-more { margin-top: 6px; padding-top: 6px; border-top-width: 1px; border-top-color: var(--line); }

/* sliders */
.dt-root .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.14); border-width: 0; border-radius: 2px; }
.dt-root .unity-base-slider__dragger { background-color: rgb(245, 243, 240); border-width: 0; border-radius: 7px; }
.dt-root .unity-base-slider__dragger-border { display: none; }

/* help text */
.dt-h { font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 14px; margin-bottom: 4px; }
.dt-p { font-size: 13px; color: rgb(214, 211, 206); margin-bottom: 6px; }
.dt-step { flex-direction: row; margin-bottom: 6px; }
.dt-step__n {
    width: 20px; height: 20px; border-radius: 10px; flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.10);
    font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center;
    margin-right: 8px; margin-top: 1px;
}
.dt-step--mug .dt-step__n { background-color: var(--mug); color: rgb(28, 20, 16); }
.dt-step--painting .dt-step__n { background-color: var(--painting); color: rgb(10, 26, 38); }
.dt-step--sound .dt-step__n { background-color: var(--green); color: rgb(10, 30, 16); }
.dt-step Label.dt-p { flex-grow: 1; flex-shrink: 1; margin-bottom: 0; }

/* ---------------------------------------------------------------- welcome */

.dt-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 7, 11, 0.74);
    align-items: center;
    justify-content: center;
}
.dt-welcome { width: 900px; max-height: 94%; padding: 26px 30px 22px 30px; margin-bottom: 0; }
.dt-welcome .dt-title { font-size: 28px; }
.dt-welcome .dt-lead { font-size: 15px; color: rgb(214, 211, 206); margin-top: 8px; }
.dt-columns { flex-direction: row; margin-top: 8px; }
.dt-column { flex-grow: 1; flex-basis: 0; margin-right: 22px; }
.dt-column--last { margin-right: 0; }
.dt-column-title { font-size: 12px; letter-spacing: 2px; -unity-font-style: bold; margin-top: 16px; margin-bottom: 8px; }
.dt-column-title--mug { color: var(--mug); }
.dt-column-title--painting { color: var(--painting); }
.dt-column-title--sound { color: var(--green); }
.dt-welcome-foot { flex-direction: row; align-items: center; margin-top: 20px; }
.dt-welcome-foot .dt-btn { height: 40px; font-size: 15px; padding: 0 26px; }

